{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hk-bus-alarm-chart",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Static chart page. Assets are matched first; only unmatched paths
  // (i.e. /api/*) reach the Worker.
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    // Unknown paths fall through to the Worker, which answers a JSON 404.
    "not_found_handling": "none"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hk-bus-alarm",
      // Fill in with the id printed by `wrangler d1 create hk-bus-alarm`.
      "database_id": "c9770e52-2640-4e87-8939-93221bea7ae2"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Custom Domain: covers every path on the hostname, so the chart is at
  // https://hk-bus-alarm-chart.iteneti.top/ and ingest at /api/ingest.
  // The iteneti.top zone must be active on this Cloudflare account; Wrangler
  // creates the DNS record and certificate on deploy. Add "workers_dev": false
  // to retire the *.workers.dev URL once the domain is verified working.
  "routes": [
    { "pattern": "hk-bus-alarm-chart.iteneti.top", "custom_domain": true }
  ]

  // INGEST_TOKEN is a secret, never a var:
  //   wrangler secret put INGEST_TOKEN          (production)
  //   echo 'INGEST_TOKEN=dev-token' > .dev.vars (local `wrangler dev`)
}
